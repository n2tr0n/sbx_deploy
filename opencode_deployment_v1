  /  \   \____  \ /  __   <   \  V  /       .:: S B X   D E P L O Y ::. /  \
  \  /  /_______//________/   /_/ \_\                                   \  /
   \/  _______________________________________________________________  \/
   /\  \__  Nitron's Deployment Script for SBX vAlpha-0.1          __/  /\
 _/  \____\_______________________________________________________/____/  \_
 \_________________________________________________________________________/

SBX_BANNER

conf="$HOME/.tmux.conf"
plugin_dir="$HOME/.tmux/plugins"
tpm_dir="$plugin_dir/tpm"
resurrect_dir="$plugin_dir/tmux-resurrect"
resurrect_plugin="$resurrect_dir/resurrect.tmux"

tpm_ready() {
    [[ -f "$tpm_dir/tpm" && -x "$tpm_dir/tpm" &&
       -f "$tpm_dir/bin/install_plugins" && -x "$tpm_dir/bin/install_plugins" ]]
}

resurrect_ready() {
    [[ -f "$resurrect_plugin" && -r "$resurrect_plugin" && -x "$resurrect_plugin" ]]
}

if [[ -e "$tpm_dir" || -L "$tpm_dir" ]] && ! tpm_ready; then
    printf 'Existing TPM path is unusable: %s\n' "$tpm_dir" >&2
    exit 1
fi

if [[ -e "$resurrect_dir" || -L "$resurrect_dir" ]] && ! resurrect_ready; then
    printf 'Existing tmux-resurrect path is unusable: %s\n' "$resurrect_dir" >&2
    exit 1
fi

if [[ ( -e "$conf" || -L "$conf" ) && ! -f "$conf" ]]; then
    printf 'Existing configuration does not point to a regular file: %s\n' "$conf" >&2
    exit 1
fi

missing_packages=()
required_packages=(
    ansible strace ltrace plocate atop htop nmon nmap git net-tools
    unzip bind9-utils rsync curl lynx tcpdump vim whois sudo tmux mtr
    cmatrix libaa-bin
)
for package in "${required_packages[@]}"; do
    if [[ $(dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null) != installed ]]; then
        missing_packages+=("$package")
    fi
done
if (( ${#missing_packages[@]} > 0 )); then
    apt=(apt-get)
    if (( EUID != 0 )); then
        if ! command -v sudo >/dev/null 2>&1; then
            printf '%s\n' 'sudo is unavailable. Install sudo as root in the sandbox, then rerun as your sandbox user.' >&2
            exit 1
        fi
        apt=(sudo apt-get)
    fi
    "${apt[@]}" update
    "${apt[@]}" install -y "${missing_packages[@]}"
fi

clone_tpm() (
    mkdir -p -- "$plugin_dir"
    staging_dir=$(mktemp -d -- "$plugin_dir/.tpm-stage.XXXXXX")
    trap 'rm -rf -- "$staging_dir"' EXIT
    git clone https://github.com/tmux-plugins/tpm "$staging_dir/checkout"
    mv -nT -- "$staging_dir/checkout" "$tpm_dir"
)

if [[ ! -e "$tpm_dir" && ! -L "$tpm_dir" ]]; then
    clone_tpm
    if ! tpm_ready; then
        printf 'TPM checkout is unusable: %s\n' "$tpm_dir" >&2
        exit 1
    fi
fi

new_conf=$(mktemp -- "$conf.tmp.XXXXXX")
trap 'rm -f -- "$new_conf"' EXIT
cat > "$new_conf" <<'TMUX_CONF'
set -g mouse on

set-option -g history-limit 1000000000

#set -g pane-border-format "#{pane_index}"
set -g pane-border-format "#[fg=colour6]#{pane_index} #[fg=yellow]#{pane_title}"
set -g pane-border-status top

setw -g window-status-format "#[fg=colour6][#I]#[fg=white]#W"
setw -g window-status-current-format "#[bg=cyan]#[fg=white]#I#[fg=black,bold]#[bg=cyan] [#W]"
set-window-option -g status-position top

set -g status-fg white
set -g status-bg black
set -g status-left-length 100
set -g status-right-length 60
set-option -g status-interval 5
set-option -g automatic-rename on
set-option -g automatic-rename-format '#{b:pane_current_path}'

set -g status-right "#[fg=green]%a %Y-%m-%d %k:%M:%S (#(date -u | awk '{print $4}') UTC)"
set -g status-left "#[fg=yellow]Remote #[fg=green]#h >>"
set-option -g renumber-windows on

#tmux plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
# set -g @resurrect-capture-pane-contents 'on'

# This line must be at the very bottom of .tmux.conf:
run '~/.tmux/plugins/tpm/tpm'
TMUX_CONF

install_tmux_config() {
    if [[ -f "$conf" ]]; then
        if cmp -s -- "$conf" "$new_conf"; then
            return 0
        else
            compare_status=$?
        fi
        if (( compare_status != 1 )); then
            printf 'Could not compare the existing configuration: %s\n' "$conf" >&2
            exit 1
        fi

        if [[ -L "$conf" ]]; then
            printf 'Configuration differs and is a symlink. Update its target before rerunning: %s\n' "$conf" >&2
            exit 1
        fi

        backup=$(mktemp -- "$conf.bak.XXXXXX")
        if ! cp -p -- "$conf" "$backup"; then
            rm -f -- "$backup"
            printf 'Could not back up the existing configuration: %s\n' "$conf" >&2
            exit 1
        fi
        printf 'Saved previous configuration to %s\n' "$backup"
    fi

    mv -fT -- "$new_conf" "$conf"
}

install_tmux_config

if ! resurrect_ready; then
    if ! "$tpm_dir/bin/install_plugins"; then
        printf '%s\n' 'TPM plugin installation failed.' >&2
        exit 1
    fi

    # TPM can exit successfully even when it finds no plugins to install.
    if ! resurrect_ready; then
        printf 'TPM did not install an executable plugin at %s\n' "$resurrect_plugin" >&2
        exit 1
    fi
fi

tmux_wrapper="$HOME/.local/bin/tmux"
wrapper_contents() {
    cat <<'TMUX_WRAPPER'
#!/bin/sh
LC_ALL=C.utf8 exec /usr/bin/tmux -u "$@"
TMUX_WRAPPER
}

if [[ -e "$tmux_wrapper" || -L "$tmux_wrapper" ]]; then
    if [[ ! -f "$tmux_wrapper" || ! -x "$tmux_wrapper" ]] ||
        ! cmp -s -- "$tmux_wrapper" <(wrapper_contents); then
        printf 'Existing tmux wrapper differs or is unusable: %s\n' "$tmux_wrapper" >&2
        exit 1
    fi
else
    (
        mkdir -p -- "${tmux_wrapper%/*}"
        staged_wrapper=$(mktemp -- "$tmux_wrapper.tmp.XXXXXX")
        trap 'rm -f -- "$staged_wrapper"' EXIT
        wrapper_contents > "$staged_wrapper"
        chmod 755 -- "$staged_wrapper"
        ln -T -- "$staged_wrapper" "$tmux_wrapper"
    )
fi

ensure_bash_path() {
    local startup_file=$1
    local marker='# SBX Deploy: put the tmux wrapper on PATH'
    if [[ -e "$startup_file" || -L "$startup_file" ]]; then
        if [[ ! -f "$startup_file" || ! -r "$startup_file" ]]; then
            printf 'Cannot read Bash startup file: %s\n' "$startup_file" >&2
            exit 1
        fi
        if grep -Fxq -- "$marker" "$startup_file"; then
            return 0
        fi
    fi

    cat >> "$startup_file" <<'SBX_BASH_PATH'

# SBX Deploy: put the tmux wrapper on PATH
case $- in
    *i*)
        case ${PATH-} in
            "$HOME/.local/bin"|"$HOME/.local/bin:"*) ;;
            *) export PATH="$HOME/.local/bin${PATH:+:$PATH}" ;;
        esac
        ;;
esac
SBX_BASH_PATH
}

ensure_bash_path "$HOME/.bashrc"
# Bash login shells read only the first readable login startup file.
login_file="$HOME/.profile"
for candidate in "$HOME/.bash_profile" "$HOME/.bash_login"; do
    if [[ -f "$candidate" && -r "$candidate" ]]; then
        login_file="$candidate"
        break
    fi
done
ensure_bash_path "$login_file"

run_as_root() {
    if (( EUID == 0 )); then
        "$@"
    else
        sudo "$@"
    fi
}

install_global_aliases() (
    global_bashrc=/etc/bash.bashrc
    marker='# SBX Deploy: custom system aliases'
    staged_global=
    cleanup() {
        if [[ -n "$staged_global" ]]; then
            run_as_root rm -f -- "$staged_global"
        fi
    }
    trap cleanup EXIT

    if [[ -L "$global_bashrc" || ! -f "$global_bashrc" || ! -r "$global_bashrc" ]]; then
        printf 'Cannot update the system-wide Bash configuration: %s\n' "$global_bashrc" >&2
        exit 1
    fi
    if grep -Fxq -- "$marker" "$global_bashrc"; then
        return 0
    fi
    if (( EUID != 0 )) && ! command -v sudo >/dev/null 2>&1; then
        printf '%s\n' 'sudo is unavailable. Install the system-wide aliases as root, then rerun.' >&2
        exit 1
    fi

    staged_global=$(run_as_root mktemp -- "$global_bashrc.tmp.XXXXXX")
    run_as_root cp -p -- "$global_bashrc" "$staged_global"
    run_as_root tee -a "$staged_global" >/dev/null <<'SBX_ALIASES'

# SBX Deploy: custom system aliases
# Custom aliases for ansible control
alias playbook='ansible-playbook'
alias playtest='ansible-playbook -C'
alias playsyntax='ansible-playbook --syntax-check'

# List active permissions on a file or folder
alias lperms='stat -c "%a %n"'

# Make a password hash
alias makepass='python -c "from passlib.hash import sha512_crypt; import getpass; print(sha512_crypt.using(rounds=5000).hash(getpass.getpass()))"'

# Strip comments and blank lines from a configuration file
alias configcat='grep -Ev "^$|^#"'

# Netstat aliases
alias netstat-numeric='netstat -tulpn'
alias netstat-names='netstat -tulp'
SBX_ALIASES

    backup=$(run_as_root mktemp -- "$global_bashrc.bak.XXXXXX")
    run_as_root cp -p -- "$global_bashrc" "$backup"
    printf 'Saved previous system-wide Bash configuration to %s\n' "$backup"
    run_as_root mv -fT -- "$staged_global" "$global_bashrc"
    staged_global=
)

install_global_aliases

cat <<'SBX_NEXT_STEPS'

Setup complete. tmux-resurrect and the UTF-8 tmux wrapper are installed.

New interactive Bash shells pick up the wrapper and system aliases
automatically. In an already-open Bash shell, run this before starting tmux:
    export PATH="$HOME/.local/bin:$PATH"; hash -r
    source /etc/bash.bashrc

Start tmux by running: tmux
To reload the configuration in an existing session:
    tmux source-file ~/.tmux.conf
To verify the locale, start a fresh tmux server and run locale charmap
inside it. Expected output: UTF-8.
SBX_NEXT_STEPS
