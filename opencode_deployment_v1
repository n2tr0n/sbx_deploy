#!/usr/bin/env bash
set -euo pipefail

# FIGlet Slant by Glenn Chappell, pre-rendered at full width.
cat <<'SBX_BANNER'

  .-----------------------------------------------------------------------.
 /__________  N I T R O N   P R E S E N T S  ______________________________\
